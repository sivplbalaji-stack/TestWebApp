@model IEnumerable<Product>

<div class="row pb-3">
    @foreach (var item in Model)
    {
        <div class="col-lg-4 col-sm-6">
            <div class="card border-0 p-3 shadow border-top border-5 rounded h-100">
                <div class="card-body d-flex flex-column">
                    @if (!string.IsNullOrEmpty(item.ImagePath))
                    {
                        <img src="@item.ImagePath" alt="@item.Name" class="img-fluid mx-auto d-block mb-3" style="max-height: 200px;" />
                    }
                    else
                    {
                        <span class="text-muted text-center">No Image</span>
                    }

                    <h5 class="card-title text-center">@item.Name</h5>
                    <p class="card-text text-center">@item.Description</p>
                    <p class="card-text text-center fw-bold">@item.Price.ToString("C")</p>
                    
                    <div class="mt-auto text-center">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-dark w-100"><i class="bi bi-info"></i> Detaills</a>
                        @* <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm me-2"><i class="bi bi-pencil"></i> Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm"><i class="bi bi-trash"></i> Delete</a> *@
                    </div>
                </div>
            </div>
        </div>
    }
</div>