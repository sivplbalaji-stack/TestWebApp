@model Product

<style>
    html, body {
        overflow-x: hidden;
        margin: 0;
        padding: 0;
    }

    body {
        overflow-y: auto;
    }
</style>

<div class="container">
    <form method="post" asp-action="Details">
        <input type="hidden" name="ProductId" asp-for="@Model.Id" />

        <div class="row justify-content-center py-4">
            <div class="col-lg-6 col-md-8">
                <div class="card border-0 p-3 shadow border-top border-5 rounded d-flex flex-column">
                    @if (Model.ImagePath != null)
                    {
                        <img src="@Model.ImagePath" alt="@Model.Name" class="card-img-top rounded" style="max-height: 200px; object-fit:cover" />
                    }
                    else
                    {
                        <img src="https://via.placeholder.com/200x200.png?text=No+Image" alt="No Image" class="card-img-top rounded" style="max-height: 200px; object-fit:cover" />
                    }

                    <div class="card-body d-flex flex-column">
                        <div class="text-center">
                            <h3 class="text-uppercase text-dark opacity-75">@Model.Name</h3>
                            <p class="text-muted small mb-2"> By <strong> @Html.Raw(Model.Description) </strong></p>
                        </div>

                        <div class="mb-3 px-2 text-center">
                            <h6 class="text-dark text-opacity-75">Price: ₹@Model.Price</h6>
                        </div>

                        <div class="px-2 mb-3 text-secondary small">
                            @Html.Raw(Model.Description)
                        </div>

                        <div class="input-group mb-3 w-50 mx-auto">
                            <span class="input-group-text bg-primary text-white border-0 fw-semiblod">Qty</span>
                            <input name="Quantity" type="number" class="form-control text-end" value="1" min="1" />
                        </div>

                        <div class="mt-auto">
                            <button type="submit" class="btn btn-dark w-100 py-2 text-uppercase fw-semiblod"><i class="bi bi-cart-plus"></i> Add to Cart</button>
                            <a asp-action="Index" class="btn btn-outline-secondary w-100 mt-2 ">Back to Products</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>